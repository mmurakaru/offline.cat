{
  "name": "offlinecat-project",
  "version": "0.3.1",
  "private": true,
  "author": "mmurakaru",
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:rust": "cd src-tauri && cargo fmt --all -- --check && cargo clippy --lib --no-default-features --all-targets -- -D warnings",
    "lint:rust:fix": "cd src-tauri && cargo fmt --all && cargo clippy --lib --no-default-features --all-targets --fix --allow-dirty --allow-staged",
    "test:rust": "cd src-tauri && cargo test --lib --no-default-features",
    "validate": "npm run lint && npm run typecheck && npx vitest run && npm run lint:rust && npm run test:rust",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "capture-demo": "CAPTURE_DEMO=1 playwright test capture-demo",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@react-router/fs-routes": "^8.4.0",
    "@react-router/node": "8.4.0",
    "@react-router/serve": "8.4.0",
    "@sqlite.org/sqlite-wasm": "^3.53.4-build2",
    "@tanstack/react-hotkeys": "^0.15.0",
    "@tanstack/react-virtual": "^3.14.21",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.0",
    "@tiptap/extension-placeholder": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@tiptap/suggestion": "^3.32.0",
    "clsx": "^2.1.1",
    "fast-xml-parser": "^5.11.2",
    "fflate": "^0.8.3",
    "i18next": "^26.5.2",
    "isbot": "^5.2.2",
    "react": "^19.3.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.0",
    "react-router": "8.4.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "tailwind-merge": "^3.7.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "^1.64.1",
    "@react-router/dev": "8.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
